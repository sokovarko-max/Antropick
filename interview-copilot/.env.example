# Copy to .env for local development only. Never commit a real key.
# Keys for both providers; the app uses whichever is selected in Settings > AI.
# In production the Anthropic key is never read from .env — it lives in
# OS secure storage (see docs/security.md). This variable only seeds the
# Settings > AI > "Test Connection" flow during `pnpm dev` in demo mode.
ANTHROPIC_API_KEY=

# Groq — free tier, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Speech-to-text provider key (see src/services/stt).
STT_API_KEY=

# Local SQLite file path (Rust backend). Defaults to the OS app-data dir if unset.
DATABASE_PATH=

# "true" enables the dev-only Debug Panel and verbose (but still redacted) logging.
DEV_MODE=false

# "true" runs the full UI against MockAIProvider / MockSTTProvider — no API key required.
DEMO_MODE=true

# Two-flag gate to log transcript/prompt content for local debugging — see docs/security.md.
# Never enable in a shipped build.
DEBUG_LOG_CONTENT=false
