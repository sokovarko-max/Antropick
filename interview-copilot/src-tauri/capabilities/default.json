{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main and overlay windows.",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
